# ==============================================================================
# DealProof AI — Environment Variables Configuration
# Srujana Tech Fest 2026 | Legal Services Hackathon (Problem LS-06)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API Configuration (Optional)
# If omitted, DealProof AI runs 100% offline using its deterministic rule engine!
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Firebase Configuration (Cloud Firestore & Authentication)
# Obtain these from Firebase Console -> Project Settings -> General -> Your Apps
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ------------------------------------------------------------------------------
# 3. Vercel Deployment Note
# In Vercel Project Settings -> Environment Variables, add the above keys.
# ------------------------------------------------------------------------------
